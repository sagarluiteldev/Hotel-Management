# ==============================================================================
# Grand Haven Hotel Management System - Environment Configuration
# ==============================================================================

# 1. PostgreSQL Database Connection String
# ------------------------------------------------------------------------------
# In production (e.g. Supabase, Neon, Railway, AWS RDS):
# Use a pooled connection string (with ?pgbouncer=true or connection_limit) for serverless deployment.
# Example: postgresql://username:password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_dashboard?schema=public"

# 2. Authentication Session Secret (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# High-entropy 64-character hex string used to sign HTTP-only session cookies.
# Generate one using command: openssl rand -hex 32
# In production (NODE_ENV=production), the application will fail to start if this is missing or < 32 chars.
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-string-minimum-32-characters"

# 3. Node Environment
# ------------------------------------------------------------------------------
# Set to 'production' on Vercel, Railway, Render, or Docker deployment.
NODE_ENV="development"
